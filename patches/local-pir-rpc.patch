+        self.lookup_traced(key).map(|(v, _)| v)
+    }
+
+    /// One client serves every request, so lookups queue on the mutex;
+    /// `lock_wait_ms` is that queueing time.
+    fn lookup_traced(&self, key: &[u8]) -> Result<(Option<Vec<u8>>, Value), PirProviderError> {
+        let t_lock = Instant::now();
         let mut client = self
             .0
             .lock()
             .map_err(|_| PirProviderError::Client("PirClient mutex poisoned".into()))?;
+        let lock_wait = t_lock.elapsed();
+        let t_lookup = Instant::now();
         let result = if key.len() == 20 {
             client.lookup_address(key)
         } else {
             client.lookup(key)
         };
+        let lookup_elapsed = t_lookup.elapsed();
+        let m = &client.last_metrics;
+        let ms = |us: u64| us as f64 / 1e3;
+        let trace = json!({
+            "lock_wait_ms": lock_wait.as_secs_f64() * 1e3,
+            "lookup_ms": lookup_elapsed.as_secs_f64() * 1e3,
+            "query_build_ms": ms(m.query_build_us),
+            "http_ms": ms(m.http_us),
+            "body_ms": ms(m.body_us),
+            "decode_ms": ms(m.decode_us),
+            "req_bytes": m.req_bytes,
+            "resp_bytes": m.resp_bytes,
+            "sidecar_bytes": m.sidecar_bytes,
+            "sidecar_entries": m.sidecar_entries,
+            "stash_entries": m.stash_entries,
+            "snapshot_block": m.snapshot_block,
+            "source": if result.is_err() { "error" } else { m.source },
+            "retried": m.retried,
+        });
         result
-            .map(|found| found.map(|l| l.value))
+            .map(|found| (found.map(|l| l.value), trace))
             .map_err(PirProviderError::Client)
     }
 }
