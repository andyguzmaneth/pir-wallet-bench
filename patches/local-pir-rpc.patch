+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn names_balance_of() {
+        let t = Tables::new(HashMap::new());
+        let data = format!("0x70a08231{:0>64}", "02");
+        let m = t.request_meta(
+            "eth_call",
+            &json!([{ "to": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48", "data": data }, "latest"]),
+        );
+        assert_eq!(m["call"]["fn"], "balanceOf(address)");
+        assert_eq!(m["call"]["fn_kind"], "erc20");
+    }
+
+    #[test]
+    fn decodes_aggregate3() {
+        // aggregate3([(0x..01, true, 0x70a08231 ++ addr 2)])
+        let inner = format!("70a08231{:0>64}", "02");
+        let inner_len = inner.len() / 2;
+        let padded = format!("{inner:0<width$}", width = inner_len.div_ceil(32) * 64);
+        let mut hexs = String::new();
+        hexs += &format!("{:064x}", 0x20); // array offset
+        hexs += &format!("{:064x}", 1); // length
+        hexs += &format!("{:064x}", 0x20); // tuple 0 offset (rel. to array data)
+        hexs += &format!("{:0>64}", "01"); // target
+        hexs += &format!("{:064x}", 1); // allowFailure
+        hexs += &format!("{:064x}", 0x60); // bytes offset rel. to tuple
+        hexs += &format!("{:064x}", inner_len);
+        hexs += &padded;
+        let t = Tables::new(HashMap::new());
+        let m = t.request_meta(
+            "eth_call",
+            &json!([{ "to": "0xcA11bde05977b3631167028862bE2a173976CA11", "data": format!("0x82ad56cb{hexs}") }]),
+        );
+        assert_eq!(m["call"]["fn"], "aggregate3((address,bool,bytes)[])");
+        assert_eq!(m["call"]["inner_count"], 1);
+        assert_eq!(m["call"]["inner"][0]["fn"], "balanceOf(address)");
+    }
+}
