index 0000000..a2a69f1
--- /dev/null
+++ b/src/trace.rs
@@ -0,0 +1,356 @@
+//! Request metadata for bench events: what a call touches, without the EVM.
+//!
+//! Everything here is best effort. A field that cannot be parsed is left out
+//! rather than failing the request.
+
+use std::collections::HashMap;
+
+use serde::Deserialize;
+use serde_json::{Map, Value, json};
+use sha3::{Digest, Keccak256};
+
+/// Function signatures worth naming in reports. Selectors are derived at
+/// startup, so a typo here shows up as an unnamed selector, not a wrong one.
+const SIGNATURES: &[(&str, &str)] = &[
+    // ERC-20
+    ("balanceOf(address)", "erc20"),
+    ("allowance(address,address)", "erc20"),
+    ("decimals()", "erc20"),
+    ("symbol()", "erc20"),
+    ("name()", "erc20"),
+    ("totalSupply()", "erc20"),
+    // Multicall
+    ("aggregate((address,bytes)[])", "multicall"),
+    ("aggregate3((address,bool,bytes)[])", "multicall"),
+    ("aggregate3Value((address,bool,uint256,bytes)[])", "multicall"),
+    ("tryAggregate(bool,(address,bytes)[])", "multicall"),
+    ("tryBlockAndAggregate(bool,(address,bytes)[])", "multicall"),
+    ("getEthBalance(address)", "multicall"),
+    ("getBlockNumber()", "multicall"),
+    // ENS
+    ("resolver(bytes32)", "ens"),
+    ("owner(bytes32)", "ens"),
+    ("addr(bytes32)", "ens"),
+    ("addr(bytes32,uint256)", "ens"),
+    ("text(bytes32,string)", "ens"),
+    ("contenthash(bytes32)", "ens"),
+    ("name(bytes32)", "ens"),
+    ("resolve(bytes,bytes)", "ens"),
+    ("reverse(bytes)", "ens"),
+    ("reverseWithGateways(bytes,uint256,string[])", "ens"),
+    ("resolveWithGateways(bytes,bytes,string[])", "ens"),
+    ("reverseResolve(address)", "names"),
+    ("available(string)", "ens"),
+    ("rentPrice(string,uint256)", "ens"),
+    ("makeCommitment(string,address,uint256,bytes32,address,bytes[],bool,uint16)", "ens"),
+    // ERC-721 / ERC-165
+    ("ownerOf(uint256)", "erc721"),
+    ("supportsInterface(bytes4)", "erc165"),
+    // Stealth addresses (ERC-5564 / ERC-6538)
+    ("stealthMetaAddressOf(address,uint256)", "stealth"),
+    ("nonceOf(address)", "stealth"),
+    // Price feeds and pools (kohaku-cli USD values)
+    ("latestRoundData()", "oracle"),
+    ("getPair(address,address)", "dex"),
+    ("getPool(address,address,uint24)", "dex"),
+    ("getReserves()", "dex"),
+    ("slot0()", "dex"),
+    ("token0()", "dex"),
+    // Privacy protocols, common views
+    ("isKnownRoot(bytes32)", "privacy"),
+    ("isSpent(bytes32)", "privacy"),
+    ("nullifierHashes(bytes32)", "privacy"),
+    ("getLastRoot()", "privacy"),
+    ("merkleRoot()", "privacy"),
+    ("treeNumber()", "privacy"),
+    ("denomination()", "privacy"),
+    ("ROOT_HISTORY_SIZE()", "privacy"),
+    ("instances(address)", "privacy"),
+    ("getAllInstanceAddresses()", "privacy"),
+];
+
+#[derive(Clone, Debug, Deserialize)]
+pub struct Label {
+    pub name: String,
+    #[serde(default)]
+    pub kind: String,
+}
+
+pub struct Tables {
+    selectors: HashMap<[u8; 4], (&'static str, &'static str)>,
+    labels: HashMap<[u8; 20], Label>,
+}
+
+impl Tables {
+    pub fn new(labels: HashMap<String, Label>) -> Self {
+        let selectors = SIGNATURES
+            .iter()
+            .map(|(sig, kind)| {
+                let h = Keccak256::digest(sig.as_bytes());
+                ([h[0], h[1], h[2], h[3]], (*sig, *kind))
+            })
+            .collect();
+        let labels = labels
+            .into_iter()
+            .filter_map(|(addr, l)| Some((parse_addr(&addr)?, l)))
+            .collect();
+        Self { selectors, labels }
+    }
+
+    pub fn label_count(&self) -> usize {
+        self.labels.len()
+    }
+
+    /// Describe one call target + calldata.
+    fn describe(&self, to: &[u8; 20], data: &[u8]) -> Map<String, Value> {
+        let mut m = Map::new();
+        m.insert("to".into(), json!(format!("0x{}", hex::encode(to))));
+        if let Some(l) = self.labels.get(to) {
+            m.insert("to_label".into(), json!(l.name));
+            if !l.kind.is_empty() {
+                m.insert("to_kind".into(), json!(l.kind));
+            }
+        }
+        m.insert("data_bytes".into(), json!(data.len()));
+        if data.len() >= 4 {
+            let sel: [u8; 4] = data[..4].try_into().unwrap();
+            m.insert("selector".into(), json!(format!("0x{}", hex::encode(sel))));
+            if let Some((sig, kind)) = self.selectors.get(&sel) {
+                m.insert("fn".into(), json!(sig));
+                m.insert("fn_kind".into(), json!(kind));
+                if *kind == "multicall" {
+                    if let Some(inner) = decode_multicall(sig, &data[4..]) {
+                        let inner: Vec<Value> = inner
+                            .iter()
+                            .map(|(t, d)| Value::Object(self.describe(t, d)))
+                            .collect();
+                        m.insert("inner_count".into(), json!(inner.len()));
+                        m.insert("inner".into(), Value::Array(inner));
+                    }
+                }
+            }
+        }
+        m
+    }
+
+    /// Method-specific metadata for one JSON-RPC item.
+    pub fn request_meta(&self, method: &str, params: &Value) -> Map<String, Value> {
+        let mut out = Map::new();
+        let arr = params.as_array();
+        let first = arr.and_then(|a| a.first());
+        match method {
+            "eth_call" | "eth_estimateGas" | "eth_createAccessList" => {
+                if let Some(obj) = first {
+                    let to = obj.get("to").and_then(Value::as_str).and_then(parse_addr);
+                    let data = obj
+                        .get("data")
+                        .or_else(|| obj.get("input"))
+                        .and_then(Value::as_str)
+                        .and_then(parse_hex)
+                        .unwrap_or_default();
+                    if let Some(to) = to {
+                        out.insert("call".into(), Value::Object(self.describe(&to, &data)));
+                    }
+                }
+                if let Some(tag) = arr.and_then(|a| a.get(1)) {
+                    out.insert("block_tag".into(), block_tag(tag));
+                }
+            }
+            "eth_getBalance" | "eth_getTransactionCount" | "eth_getCode" => {
+                if let Some(addr) = first.and_then(Value::as_str).and_then(parse_addr) {
+                    let mut m = Map::new();
+                    m.insert("address".into(), json!(format!("0x{}", hex::encode(addr))));
+                    if let Some(l) = self.labels.get(&addr) {
+                        m.insert("label".into(), json!(l.name));
+                    }
+                    out.insert("account".into(), Value::Object(m));
+                }
+                out.insert(
+                    "block_tag".into(),
+                    arr.and_then(|a| a.get(1)).map_or(json!("latest"), block_tag),
+                );
+            }
+            "eth_getStorageAt" => {
+                if let Some(tag) = arr.and_then(|a| a.get(2)) {
+                    out.insert("block_tag".into(), block_tag(tag));
+                }
+            }
+            "eth_getLogs" => {
+                if let Some(f) = first {
+                    out.insert("logs".into(), Value::Object(self.logs_meta(f)));
+                }
+            }
+            _ => {}
+        }
+        out
+    }
+
+    fn logs_meta(&self, f: &Value) -> Map<String, Value> {
+        let mut m = Map::new();
+        let addrs: Vec<String> = match f.get("address") {
+            Some(Value::String(s)) => vec![s.clone()],
+            Some(Value::Array(a)) => a.iter().filter_map(|v| v.as_str().map(String::from)).collect(),
+            _ => vec![],
+        };
+        let labels: Vec<Value> = addrs
+            .iter()
+            .map(|a| {
+                parse_addr(a)
+                    .and_then(|b| self.labels.get(&b))
+                    .map_or(Value::Null, |l| json!(l.name))
+            })
+            .collect();
+        m.insert("addresses".into(), json!(addrs));
+        m.insert("labels".into(), Value::Array(labels));
+        let from = f.get("fromBlock").and_then(Value::as_str);
+        let to = f.get("toBlock").and_then(Value::as_str);
+        m.insert("from".into(), json!(from));
+        m.insert("to".into(), json!(to));
+        if let (Some(a), Some(b)) = (from.and_then(parse_qty), to.and_then(parse_qty)) {
+            m.insert("span".into(), json!(b.saturating_sub(a) + 1));
+        }
+        if let Some(t0) = f.get("topics").and_then(Value::as_array).and_then(|t| t.first()) {
+            m.insert("topic0".into(), t0.clone());
+        }
+        if f.get("blockHash").is_some() {
+            m.insert("by_block_hash".into(), json!(true));
+        }
+        m
+    }
+}
+
+/// Per-result metadata: chain head from `eth_blockNumber`, log counts.
+pub fn result_meta(method: &str, result: &Value) -> Map<String, Value> {
+    let mut m = Map::new();
+    match method {
+        "eth_blockNumber" => {
+            if let Some(n) = result.as_str().and_then(parse_qty) {
+                m.insert("head_block".into(), json!(n));
+            }
+        }
+        "eth_getLogs" => {
+            if let Some(a) = result.as_array() {
+                m.insert("log_count".into(), json!(a.len()));
+            }
+        }
+        "eth_getBlockByNumber" => {
+            if let Some(n) = result.get("number").and_then(Value::as_str).and_then(parse_qty) {
+                m.insert("block_number".into(), json!(n));
+            }
+        }
+        _ => {}
+    }
+    m
+}
+
+fn block_tag(v: &Value) -> Value {
+    match v {
+        Value::String(s) => json!(s),
+        Value::Object(o) => o
+            .get("blockNumber")
+            .or_else(|| o.get("blockHash"))
+            .cloned()
+            .map_or(json!("object"), |x| x),
+        Value::Null => json!("latest"),
+        other => other.clone(),
+    }
+}
+
+fn parse_hex(s: &str) -> Option<Vec<u8>> {
+    let s = s.strip_prefix("0x").or_else(|| s.strip_prefix("0X")).unwrap_or(s);
+    hex::decode(s).ok()
+}
+
+fn parse_addr(s: &str) -> Option<[u8; 20]> {
+    parse_hex(s)?.try_into().ok()
+}
+
+fn parse_qty(s: &str) -> Option<u64> {
+    let h = s.strip_prefix("0x")?;
+    u64::from_str_radix(h, 16).ok()
+}
+
+fn word(buf: &[u8], at: usize) -> Option<&[u8]> {
+    buf.get(at..at.checked_add(32)?)
+}
+
+fn word_usize(buf: &[u8], at: usize) -> Option<usize> {
+    let w = word(buf, at)?;
+    if w[..24].iter().any(|b| *b != 0) {
+        return None;
+    }
+    Some(u64::from_be_bytes(w[24..32].try_into().ok()?) as usize)
+}
+
+/// Decode the inner (target, calldata) pairs of a Multicall call. `args` is
+/// calldata after the selector.
+fn decode_multicall(sig: &str, args: &[u8]) -> Option<Vec<([u8; 20], Vec<u8>)>> {
+    // (index of the bytes field in the tuple, head words before the array offset)
+    let (bytes_idx, lead) = match sig {
+        "aggregate((address,bytes)[])" => (1, 0),
+        "aggregate3((address,bool,bytes)[])" => (2, 0),
+        "aggregate3Value((address,bool,uint256,bytes)[])" => (3, 0),
+        "tryAggregate(bool,(address,bytes)[])" | "tryBlockAndAggregate(bool,(address,bytes)[])" => {
+            (1, 1)
+        }
+        _ => return None,
+    };
+    let arr_off = word_usize(args, lead * 32)?;
+    let n = word_usize(args, arr_off)?;
+    if n > 10_000 {
+        return None;
+    }
+    let base = arr_off + 32;
+    let mut out = Vec::with_capacity(n);
+    for i in 0..n {
+        let tuple = base + word_usize(args, base + i * 32)?;
+        let target: [u8; 20] = word(args, tuple)?[12..32].try_into().ok()?;
+        let data_off = tuple + word_usize(args, tuple + bytes_idx * 32)?;
+        let len = word_usize(args, data_off)?;
+        let data = args.get(data_off + 32..data_off + 32 + len)?.to_vec();
+        out.push((target, data));
+    }
+    Some(out)
+}
