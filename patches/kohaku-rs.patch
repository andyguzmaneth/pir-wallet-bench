     fn lookup(&self, key: &[u8]) -> Result<Option<Vec<u8>>, PirProviderError>;
+
+    /// Like [`Self::lookup`], plus backend-specific metrics (timings, bytes)
+    /// as JSON. The default reports none.
+    ///
+    /// # Errors
+    ///
+    /// Same as [`Self::lookup`].
+    fn lookup_traced(
+        &self,
+        key: &[u8],
+    ) -> Result<(Option<Vec<u8>>, serde_json::Value), PirProviderError> {
+        Ok((self.lookup(key)?, serde_json::Value::Null))
+    }
 }
 
