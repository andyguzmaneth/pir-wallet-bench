# Copy to bench.env and edit. bench.env is gitignored (the RPC URL may hold a key).

# inspire-gpu-serving endpoint to test against: run your own
# (github.com/keewoolee/inspire-gpu-serving) or ask the EF Reads team for one.
PIR_URL=http://<pir-server-host>:18090
# Plain mainnet JSON-RPC: fallback for the proxy and the replay baseline.
# PENDING: replace publicnode with the dedicated URL.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# mainnet or sepolia. Sepolia runs shadow mode (PIR timing, answers from the
# Sepolia RPC) and send flows on the persistent wallet in runs/_wallets/sepolia.
NETWORK=mainnet
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# 1 = publish the redacted reports to GitHub Pages after each run
PUBLISH_PAGES=1
# Label and note stored with each run, shown in the run index.
RUN_LABEL=
RUN_NOTE=

# Stages to run, in order: drive,replay,load,report
STAGES=drive,replay,load,report
# kohaku-cli scenarios (bench/drive.py --help lists them). Empty = default set.
SCENARIOS=
# next-fresh-address repetitions in fresh_addresses
FRESH=5
# Seconds per kohaku command before the driver gives up
SCENARIO_TIMEOUT=1500
# Parallel wallets for the replay and the direct PIR load test
REPLAY_CONCURRENCY=1,4,16
LOAD_CONCURRENCY=1,2,4,8,16
LOAD_LOOKUPS=5
# Timing probes that split a lookup into round trip, upload, server and download
PROBES=20
# Skip these methods in the replay (comma list)
REPLAY_EXCLUDE=
# Local proxy port
PORT=18545
# 1 = keep Tor for kohaku-cli non-RPC HTTP (slower; RPC is clearnet either way)
TOR=0
